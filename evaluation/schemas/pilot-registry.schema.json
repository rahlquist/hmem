{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hmem.dev/evaluation/schemas/pilot-registry.schema.json",
  "title": "hmem Pilot Registry",
  "description": "Provider compatibility/integration state, dev/held-out split metadata, claim provenance/evidence classes, and privacy rules for the hmem pilot. Registry schema v1.0.0.",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "spec_version",
    "generated_by",
    "generated_at",
    "split",
    "providers",
    "claim_evidence_classes",
    "integration_states",
    "privacy_rules"
  ],
  "properties": {
    "registry_id": { "type": "string", "minLength": 1 },
    "spec_version": { "type": "string", "const": "1.0.0" },
    "generated_by": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "dev", "held_out", "immutable_regression_core"],
      "properties": {
        "policy": { "type": "string" },
        "dev": { "type": "array", "items": { "type": "string" } },
        "held_out": { "type": "array", "items": { "type": "string" } },
        "immutable_regression_core": { "type": "array", "items": { "type": "string" } },
        "note": { "type": ["string", "null"] }
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider_id", "name", "kind", "integration_state", "evidence_class", "status"],
        "properties": {
          "provider_id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "enum": ["builtin", "plugin", "mcp", "baseline", "reference"] },
          "integration_state": { "$ref": "#/definitions/integration_state" },
          "evidence_class": { "$ref": "#/definitions/evidence_class" },
          "status": { "enum": ["configured", "not-configured", "unknown", "partial"] },
          "latest_known_version": { "type": ["string", "null"] },
          "verified_against_hermes": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] },
          "setup_failures": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "claim_evidence_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "definition"],
        "properties": {
          "id": { "$ref": "#/definitions/evidence_class" },
          "definition": { "type": "string" }
        }
      }
    },
    "integration_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "definition"],
        "properties": {
          "id": { "$ref": "#/definitions/integration_state" },
          "definition": { "type": "string" }
        }
      }
    },
    "privacy_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rule"],
        "properties": {
          "id": { "type": "string" },
          "rule": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "integration_state": {
      "enum": [
        "bundled",
        "third-party-plugin",
        "mcp-only",
        "hook-integration",
        "documented-untested",
        "tested-hermes-release",
        "not-configured"
      ]
    },
    "evidence_class": {
      "enum": [
        "hmem-measured",
        "independently-reproduced",
        "vendor-documented",
        "vendor-benchmark",
        "community-reported",
        "inferred",
        "unknown"
      ]
    }
  }
}
